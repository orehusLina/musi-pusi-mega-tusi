# Токен бота от @BotFather
BOT_TOKEN=

# Секретное слово для подруг: присылают его боту или вводят в приложении
INVITE_CODE=

# Свой https-домен, если появится (иначе используется туннель Cloudflare)
PUBLIC_URL=

# Часовой пояс и город для погоды (по умолчанию Москва)
TZ=Europe/Moscow
CITY_LAT=55.7558
CITY_LON=37.6173

# Сколько «хочу» достаточно поставить за раунд и после скольких карточек раунд для человека закончен
LIKES_TARGET=3
MAX_SHOWN=10

# Необязательно: нейросеть Gemini разбирает текст и страницы в поля карточки
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
